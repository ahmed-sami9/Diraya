NODE_ENV=development
PORT=5000
# The browser app's address: CORS, the CSRF origin check and links in emails.
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://user:password@localhost:5432/diraya_app_db
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally: without it, emails are printed in the terminal.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Diraya <no-reply@yourdomain.com>
EMAIL_FROM=
